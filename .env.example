# Legal PDF Analyzer AI - Environment Configuration

# Hosted LLM API Key (Gemini API or OpenAI API)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=

# LLM Model Name
LLM_MODEL=gemini-2.5-flash

# Backend Configuration
PORT=8000
HOST=0.0.0.0

# Environment Mode (development / production)
ENV=development

# CORS allowed origins (comma-separated). In production set to your actual frontend domain.
# Example: ALLOWED_ORIGINS=https://yourapp.com,https://www.yourapp.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
